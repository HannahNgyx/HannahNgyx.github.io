{
  "permissions": {
    "allow": [
      "Bash(npm run qa:shots *)",
      "Bash(npm run qa:shots)",
      "Bash(npm run build)",
      "Bash(git fetch)",
      "Bash(git fetch origin)",
      "Bash(git fetch -q origin)",
      "Bash(git fetch origin epic)",
      "Bash(gh project item-list *)",
      "Bash(gh project field-list *)",
      "Bash(gh project view *)",
      "Bash(gh label list *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(gh pr merge:*)",
      "Bash(gh issue close:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin epic:*)",
      "Bash(git push -u origin main:*)",
      "Bash(git push -u origin epic:*)",
      "Bash(git push origin HEAD:main:*)",
      "Bash(git push origin HEAD:epic:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "PowerShell(gh pr merge:*)",
      "PowerShell(gh issue close:*)",
      "PowerShell(git push origin main:*)",
      "PowerShell(git push origin epic:*)",
      "PowerShell(git push --force:*)",
      "PowerShell(git push -f:*)"
    ]
  }
}
